# ==============================================================================
# PROJECT LIVING ROOM — CONFIGURATION D'ENVIRONNEMENT (EXEMPLE SANS SECRETS)
# ==============================================================================
# Ce dépôt fonctionne par défaut en mode 100 % local-first (localStorage) sans
# nécessiter de backend ni de clés d'API.
# Ne commitez JAMAIS de fichier .env ou .env.local contenant de vrais secrets.

# Mode d'exécution de l'espace fondateur ('local_only' par défaut)
NEXT_PUBLIC_WORKSPACE_MODE=local_only

# Cible temporelle et géographique (affichée à titre indicatif)
NEXT_PUBLIC_PROJECT_TARGET_CITY=Paris
NEXT_PUBLIC_PROJECT_TARGET_OPENING=2027-12

# ------------------------------------------------------------------------------
# OPTIONNEL (PHASE ULTÉRIEURE) : GATING D'AUTHENTIFICATION & SUPABASE PRIVÉ
# Laisser vide tant que le projet reste en usage local fondateur.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# FOUNDER_ALLOWED_EMAILS=fondateur1@example.com,fondateur2@example.com
# WORKSPACE_SESSION_SECRET=
