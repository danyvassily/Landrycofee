# ==============================================================================
# PROJECT LIVING ROOM — CONFIGURATION D'ENVIRONNEMENT (EXEMPLE SANS SECRETS)
# ==============================================================================
# Ce prototype MVP fonctionne en mode 100 % local-first (localStorage) sans
# backend ni authentification active.
# N'y stockez JAMAIS de vrais secrets ni de données personnelles sensibles.

NEXT_PUBLIC_WORKSPACE_MODE=local_prototype
NEXT_PUBLIC_PROJECT_TARGET_CITY=Paris
NEXT_PUBLIC_PROJECT_TARGET_OPENING=2027-12

# ------------------------------------------------------------------------------
# PHASE ULTÉRIEURE (NON IMPLÉMENTÉE DANS CE MVP) :
# Connexion optionnelle à un service d'authentification et de base de données
# géré (ex. Supabase Auth + PostgreSQL avec politiques RLS).
# Ne jamais implémenter de cryptographie ou de gestion de session maison.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
